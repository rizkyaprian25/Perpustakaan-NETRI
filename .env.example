# ==============================================================================
# Environment Configuration Template - Perpustakaan SMPN 3 CIBUNGBULANG
# Salin file ini menjadi `.env` di server fisik sekolah dan sesuaikan nilainya.
# JANGAN PERNAH MENGUNGGAH FILE `.env` KE GITHUB / REMOTE REPOSITORY!
# ==============================================================================

# Mode Lingkungan (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.200

# Konfigurasi Server Fisik
SERVER_NAME="SMPN 3 CIBUNGBULANG"
SERVER_LAN_IP="192.168.1.200"
SERVER_HTTP_PORT=80

# Kredensial Basis Data MariaDB / MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_perpus_smpn3
DB_USERNAME=perpus_admin
DB_PASSWORD=GantiPasswordKuatIni2026!

# Pengaturan Cadangan Otomatis (Backup)
BACKUP_DIR=/var/backups/perpus_smpn3
BACKUP_RETENTION_DAYS=14
